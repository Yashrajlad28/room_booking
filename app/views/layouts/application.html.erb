<html>

  <body>
    <p class="notice"><%= notice %></p> 
    <p class="alert"><%= alert %></p> 

    <nav style="background: #f4f4f4; padding: 10px; border-bottom: 1px solid #ddd; display: flex; justify-content: space-between; align-items: center;">
      <div>
        <strong>RoomBooking</strong> | 
        <%= link_to "My Bookings", api_v2_bookings_path %>
      </div>

      <div>
        <% if user_signed_in? %>
          <span> <%= link_to "New Booking", new_api_v2_booking_path %> </span>
          <span>Welcome, <strong><%= current_user.name %></strong>!</span>
          <%= button_to "Log Out", destroy_user_session_path, method: :delete %>
        <% else %>
          <%= link_to "Login", new_user_session_path %>
        <% end %>
      </div>
    </nav>

    <div style="padding: 20px;">
      <%= yield %>
    </div>
  </body>

</html>
