<table class="table table-striped table-hover align-middle">
  <thead class="table-dark">
    <tr>
      <th>Sr No.</th>
      <% if current_user.admin? %>
        <th>User Name</th>
      <% end %>
      <th>Room Name</th>
      <th>Date</th>
      <th>Start Time</th>
      <th>End Time</th>
      <th>Status</th>
      <th class="text-center">Action</th>
    </tr>
  </thead>

  <tbody>
    <% @bookings.each_with_index do |booking, num| %>
      <tr>
        <td><%= num + 1 %></td>
        <% if current_user.admin? %>
          <td><%= booking.user.name %></td>
        <% end %>
        <td><span class="fw-semibold"><%= booking.room.name %></span></td>
        <td><%= booking.booking_date.strftime("%B %d, %Y") %></td>
        <td><%= booking.start_time.strftime("%I:%M %p") %></td>
        <td><%= booking.end_time.strftime("%I:%M %p") %></td>
        <td><%= booking.status %></td>
        <td class="text-center">
          <%= link_to "Show", api_v2_booking_path(booking.id), class: "btn btn-sm btn-outline-primary" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>