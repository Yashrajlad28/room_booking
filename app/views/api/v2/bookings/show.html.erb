<h1>Showing the details of Booking</h1>


<%= button_to "Delete", api_v2_booking_path(@booking), method: :delete, 
data: { turbo_confirm: "Are you sure? You want to delete" } %>

<%= link_to "Edit", api_v2_bookings_path %>

<%= button_to "Cancel Booking", cancel_api_v2_booking_path(@booking), 
            method: :patch, 
            data: { turbo_confirm: "Are you sure about cancellation?" }, 
            class: "btn-danger" %>