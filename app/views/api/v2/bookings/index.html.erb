<div class="container mt-4">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3><%= current_user.name %>'s Bookings</h3>

    <%= link_to "New Booking", new_api_v2_booking_path, class: "btn btn-primary" %>
  </div>

  <div class="card shadow-sm">

    <div class="card-body">

      <% if @bookings.any? %>
        <%= render 'shared/bookings_table' %>
      <% else %>
        <div class="text-center p-4 text-muted">No bookings found.</div>
      <% end %>

    </div>

  </div>

</div>

