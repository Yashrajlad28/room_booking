<div class="container mt-4">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3><%= current_user.name %>'s Bookings</h3>

    <%= link_to "New Booking", new_api_v2_booking_path, class: "btn btn-primary" %>
  </div>

  <div class="card shadow-sm">

    <div class="card-body">

      <table class="table table-striped table-hover align-middle">

        <thead class="table-dark">
          <tr>
            <th>Sr No.</th>
            <th>Room Name</th>
            <th>Date</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th class="text-center">Action</th>
          </tr>
        </thead>

        <tbody>

          <% @bookings.each_with_index do |booking, num| %>
            <tr>
              <td><%= num + 1 %></td>

              <td>
                <span class="fw-semibold">
                  <%= booking.room.name %>
                </span>
              </td>

              <td>
                <%= booking.booking_date.strftime("%B %d, %Y") %>
              </td>

              <td>
                <%= booking.start_time.strftime("%I:%M %p") %>
              </td>

              <td>
                <%= booking.end_time.strftime("%I:%M %p") %>
              </td>

              <td class="text-center">
                <%= link_to "Show",
                api_v2_booking_path(booking.id),
                class: "btn btn-sm btn-outline-primary" %>
              </td>
            </tr>
          <% end %>

        </tbody>

      </table>

      <% if @bookings.empty? %>
        <div class="text-center p-4 text-muted">
          No bookings found.
        </div>
      <% end %>

    </div>

  </div>

</div>

