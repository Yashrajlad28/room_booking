<div class="container mt-4">

  <div class="card shadow-sm mb-4">
    <div class="card-header">
      <h4 class="mb-0">Search Available Rooms</h4>
    </div>

    <div class="card-body">

      <%= form_with(url: new_api_v2_booking_path, method: :get, local: true) do |f| %>

        <div class="row g-3">

          <div class="col-md-4">
            <%= f.label :booking_date, class: "form-label" %>
            <%= f.date_field :booking_date,
            value: params[:booking_date] || Date.today,
            class: "form-control",
            required: true %>
          </div>

          <div class="col-md-3">
            <%= f.label :start_time, class: "form-label" %>
            <%= f.time_field :start_time,
            value: params[:start_time] || Time.current.strftime("%H:%M"),
            class: "form-control",
            required: true %>
          </div>

          <div class="col-md-3">
            <%= f.label :end_time, class: "form-label" %>
            <%= f.time_field :end_time,
            value: params[:end_time],
            class: "form-control",
            required: true %>
          </div>

          <div class="col-md-2 d-flex align-items-end">
            <%= f.submit "Search", class: "btn btn-primary w-100" %>
          </div>

        </div>

      <% end %>

    </div>
  </div>

  <% if params[:booking_date].present? && params[:start_time].present? && params[:end_time].present? %>
    <% b = Booking.new(
      booking_date:params[:booking_date],
      start_time:params[:start_time],
      end_time:params[:end_time]
      ) 
    %>
    <% if b.valid? %>

      <div class="card shadow-sm">
        <div class="card-header">
          <h5 class="mb-0">Available Rooms</h5>
        </div>

        <div class="card-body">

          <% if @available_rooms.present? %>

            <table class="table table-striped table-hover align-middle">

              <thead class="table-dark">
                <tr>
                  <th>Room Name</th>
                  <th class="text-center">Action</th>
                </tr>
              </thead>

              <tbody>

                <% @available_rooms.each do |room| %>
                  <tr>

                    <td class="fw-semibold">
                      <%= room.name %>
                    </td>

                    <td class="text-center">

                      <%= form_with scope: :booking,
                      url: api_v2_bookings_path,
                      local: true do |f| %>

                        <%= f.hidden_field :room_id, value: room.id %>
                        <%= f.hidden_field :booking_date, value: params[:booking_date] %>
                        <%= f.hidden_field :start_time, value: params[:start_time] %>
                        <%= f.hidden_field :end_time, value: params[:end_time] %>

                        <%= f.submit "Book",
                        class: "btn btn-sm btn-success" %>

                      <% end %>

                    </td>

                  </tr>
                <% end %>

              </tbody>

            </table>

          <% else %>

            <div class="alert alert-warning text-center mb-0">
              Sorry! No rooms available for the selected time.
            </div>

          <% end %>

        </div>
      </div>

    <%else%>
      <% flash.now[:alert] = b.errors.full_messages.join(", ") %>
    <% end %>
  <% end %>

  <div class="mt-3">
    <%= link_to "Back", api_v2_bookings_path, class: "btn btn-outline-secondary" %>
  </div>

</div>