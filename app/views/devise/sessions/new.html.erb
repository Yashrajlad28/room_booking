<div class="container mt-5" style="max-width: 440px;">

  <div class="card border-0 rounded-3 overflow-hidden" style="box-shadow: 0 1px 12px rgba(0,0,0,0.08);">

    <%# ---- Header ---- %>
    <div class="card-header text-center py-4 border-0" style="background: #1a1f2e;">
      <p class="mb-1">
        <span style="display:inline-block; width:8px; height:8px; border-radius:50%;
                     background:#4e9af1; margin-right:6px; vertical-align:middle;"></span>
        <span class="fw-semibold text-white" style="font-size:1rem; vertical-align:middle;">RoomBooking</span>
      </p>
      <p class="mb-0" style="font-size: 0.8rem; color: #8a93a8;">Create your account</p>
    </div>

    <%# ---- Body ---- %>
    <div class="card-body p-4" style="background: #fff;">

      <%= render "devise/shared/error_messages", resource: resource %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

        <div class="mb-3">
          <%= f.label :email, "Email address", class: "form-label fw-medium",
              style: "font-size: 0.82rem; color: #3a3f52;" %>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              placeholder: "you@example.com",
              class: "form-control",
              required: true,
              style: "border-radius: 7px; font-size: 0.875rem; border-color: #d1d5e0;" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, class: "form-label fw-medium",
              style: "font-size: 0.82rem; color: #3a3f52;" %>
          <%= f.password_field :password,
              autocomplete: "new-password",
              placeholder: "••••••••",
              class: "form-control",
              required: true,
              style: "border-radius: 7px; font-size: 0.875rem; border-color: #d1d5e0;" %>
          <% if @minimum_password_length %>
            <div class="form-text" style="font-size: 0.75rem; color: #8a93a8;">
              At least <%= @minimum_password_length %> characters
            </div>
          <% end %>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation, "Confirm password", class: "form-label fw-medium",
              style: "font-size: 0.82rem; color: #3a3f52;" %>
          <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              placeholder: "••••••••",
              class: "form-control",
              required: true,
              style: "border-radius: 7px; font-size: 0.875rem; border-color: #d1d5e0;" %>
        </div>

        <div class="d-grid mb-4">
          <%= f.submit "Create account", class: "btn fw-medium",
              style: "background: #4e9af1; color: #fff; border-radius: 7px;
                      font-size: 0.875rem; padding: 10px;" %>
        </div>

      <% end %>

      <hr style="border-color: rgba(0,0,0,0.07); margin-bottom: 1rem;">

      <p class="text-center mb-0" style="font-size: 0.82rem; color: #8a93a8;">
        Already have an account?
        <%= link_to "Log in", new_user_session_path,
            style: "color: #4e9af1; font-weight: 500; text-decoration: none;" %>
      </p>

    </div>
  </div>
</div>